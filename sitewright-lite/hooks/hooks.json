{
  "description": "Sitewright lite hooks; none writes to the project or anywhere else. PreToolUse: WP-CLI guard asks before hard-to-reverse wp commands. PostToolUse: a records check (docs/website records). SessionStart: opt-in state summary (state.json session_summary). Stop: evidence gate when state.json declares handoff, blocking at most once per stop.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/wp_guard.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/sitewright_hook.py\" post-write",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/sitewright_hook.py\" session-start --data \"${CLAUDE_PLUGIN_DATA}\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/sitewright_hook.py\" stop",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
